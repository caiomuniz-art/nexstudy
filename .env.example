# Copie este arquivo para .env.local. Não coloque valores reais aqui.

# URL do projeto, em Project Settings → API. Exemplo de formato: https://seuprojeto.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave anon/public. Pode ir no navegador porque o RLS limita os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública usada nos links de confirmação e recuperação de senha.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Não crie uma variável pública com a chave secreta de administração do Supabase.
# Essa chave ignora o RLS e não pode ir para o navegador.
# Este aplicativo não lê essa chave. A exclusão da conta usa a função delete_own_account.

# Integração de e-mail ainda não implementada. O aplicativo não lê estas variáveis
# e não envia mensagens. Elas ficam documentadas para uma etapa futura:
# EMAIL_FROM=
# RESEND_API_KEY=
